{
  "name": "LeadEdge360 — AEO Profile Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "weeks", "weeksInterval": 1 }] }
      },
      "id": "WeeklyCron",
      "name": "Monday 09:00 weekly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "url": "={{$env.ASOFTECH_API}}/api/users/me",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "GetProfile",
      "name": "GET users/me",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [440, 300],
      "credentials": { "httpHeaderAuth": "LEADEDGE_ADMIN_JWT" }
    },
    {
      "parameters": {
        "jsCode": "const profile = $json.preferences?.aeoProfile || {};\nconst completeness = profile.completenessPct ?? 0;\nconst threshold = 60;\nif (completeness >= threshold) return [];\nreturn [{ json: { completeness, title: 'Complete AEO business profile', dueAt: new Date(Date.now() + 24*3600*1000).toISOString() } }];"
      },
      "id": "CheckCompleteness",
      "name": "IF completeness < 60",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "url": "={{$env.ASOFTECH_API}}/api/followups",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { title: $json.title, channel: 'other', dueAt: $json.dueAt, notes: 'AEO profile completeness below 60%' } }}"
      },
      "id": "CreateFollowup",
      "name": "POST followup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [880, 300],
      "credentials": { "httpHeaderAuth": "LEADEDGE_ADMIN_JWT" }
    }
  ],
  "connections": {
    "Monday 09:00 weekly": { "main": [[{ "node": "GET users/me", "type": "main", "index": 0 }]] },
    "GET users/me": { "main": [[{ "node": "IF completeness < 60", "type": "main", "index": 0 }]] },
    "IF completeness < 60": { "main": [[{ "node": "POST followup", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
