{
  "$comment": "CANONICAL design token source for AsoftechInsightz V2. All theme/CSS/Tailwind changes in Phase 2+ MUST derive from this file. Do not duplicate values elsewhere.",
  "meta": {
    "version": "1.0.0",
    "authority": "docs/SOURCE_OF_TRUTH.md",
    "brandReference": "AsoftechInsightz official brochure",
    "lastUpdated": "2026-06-21"
  },
  "brand": {
    "personality": ["enterprise", "trusted", "professional", "innovative", "scalable", "global"],
    "promise": "Innovate • Integrate • Deliver • Satisfy",
    "taglines": {
      "master": "End-to-End Digital Transformation Partner",
      "leadedge360": "Capture. Engage. Convert.",
      "retailedge360": "Smart Retail. Simplified Growth."
    },
    "colors": {
      "primaryBlue": { "hex": "#0066FF", "role": "primary actions, enterprise accent" },
      "deepNavy": { "hex": "#0A1F44", "role": "sidebar, headers, corporate" },
      "cyan": { "hex": "#00C6FF", "role": "Insightz accent, highlights" },
      "leadedgeGreen": { "hex": "#22C55E", "role": "LeadEdge360 growth accent" },
      "retailOrange": { "hex": "#FF7A00", "role": "RetailEdge360 commerce accent" },
      "white": { "hex": "#FFFFFF", "role": "text on dark" },
      "lightGray": { "hex": "#F5F7FA", "role": "marketing backgrounds" },
      "navy": { "hex": "#0A1F44", "role": "alias — deepNavy" },
      "royalBlue": { "hex": "#0066FF", "role": "alias — primaryBlue" },
      "electricBlue": { "hex": "#00C6FF", "role": "alias — cyan" },
      "orange": { "hex": "#FF7A00", "role": "alias — retailOrange" }
    },
    "legacyDoNotUse": {
      "$comment": "Present in app/globals.css and tailwind.config.js — replace in Phase 2, do not extend",
      "orange": "#FF8A3D",
      "greenAccent": "#22C55E",
      "navy": "#070B14"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter",
      "display": "Space Grotesk"
    },
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem",
      "6xl": "3.75rem"
    },
    "weight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "unit": 4,
    "scale": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem"
    },
    "layout": {
      "pagePaddingX": "1.5rem",
      "pagePaddingY": "2rem",
      "sectionGap": "4rem",
      "cardPadding": "1.5rem",
      "sidebarWidth": "16rem",
      "headerHeight": "4rem"
    }
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "full": "9999px",
    "default": "0.85rem"
  },
  "shadows": {
    "xs": "0 1px 2px 0 rgba(7, 27, 77, 0.05)",
    "sm": "0 1px 3px 0 rgba(7, 27, 77, 0.08), 0 1px 2px -1px rgba(7, 27, 77, 0.08)",
    "md": "0 4px 6px -1px rgba(7, 27, 77, 0.08), 0 2px 4px -2px rgba(7, 27, 77, 0.06)",
    "lg": "0 10px 15px -3px rgba(7, 27, 77, 0.08), 0 4px 6px -4px rgba(7, 27, 77, 0.06)",
    "xl": "0 20px 25px -5px rgba(7, 27, 77, 0.1), 0 8px 10px -6px rgba(7, 27, 77, 0.08)",
    "focus": "0 0 0 3px rgba(25, 118, 210, 0.35)"
  },
  "elevation": {
    "0": { "shadow": "none", "zIndex": 0 },
    "1": { "shadow": "sm", "zIndex": 10 },
    "2": { "shadow": "md", "zIndex": 20 },
    "3": { "shadow": "lg", "zIndex": 30 },
    "4": { "shadow": "xl", "zIndex": 40 }
  },
  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "250ms",
      "slow": "400ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)"
    }
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1400px"
  },
  "focus": {
    "ringWidth": "3px",
    "ringOffset": "2px",
    "ringColor": "electricBlue"
  },
  "accessibility": {
    "minTouchTarget": "44px",
    "minContrastRatio": "4.5:1",
    "reducedMotion": "prefers-reduced-motion: reduce"
  },
  "themes": {
    "marketing": {
      "description": "Premium, conversion-focused, light-leaning surfaces on www",
      "inspiration": ["Salesforce", "HubSpot", "Datadog", "IBM", "Dynatrace"],
      "mode": "light-primary",
      "background": "#F5F7FA",
      "foreground": "#071B4D",
      "cta": "#FF7A00"
    },
    "suite": {
      "description": "Enterprise dark theme for app.asoftechinsightz.com",
      "inspiration": ["Salesforce", "ServiceNow", "Dynatrace", "Monday.com"],
      "mode": "dark",
      "background": "#071B4D",
      "surface": "#0B1220",
      "foreground": "#FFFFFF",
      "accent": "#FF7A00",
      "avoid": ["gaming UI", "neon colors", "cartoon illustrations", "excessive glassmorphism"]
    }
  },
  "domains": {
    "marketing": "www.asoftechinsightz.com",
    "app": "app.asoftechinsightz.com",
    "products": {
      "leadedge360": {
        "subdomain": "leadedge360.asoftechinsightz.com",
        "route": "/leadedge360",
        "status": "active"
      },
      "retailedge360": {
        "subdomain": "retailedge360.asoftechinsightz.com",
        "route": "/retailedge360",
        "status": "active"
      },
      "partneredge360": { "route": "/partneredge360", "status": "planned" },
      "customeredge360": { "route": "/customeredge360", "status": "planned" },
      "observability360": {
        "subdomain": "app.observability360.asoftechinsightz.com",
        "apiSubdomain": "api-observability360.asoftechinsightz.com",
        "route": "/products/trinetra360",
        "status": "external",
        "codebase": "Observability360",
        "note": "Standalone product — not merged into LeadEdge/Retail suite shell"
      },
      "compliance360": { "route": "/compliance360", "status": "planned" }
    }
  },
  "routes": {
    "marketing": ["/", "/about", "/products", "/solutions", "/industries", "/pricing", "/blog", "/contact", "/growth-audit", "/download", "/privacy", "/terms", "/partners", "/services"],
    "auth": ["/signin", "/splash", "/product-selection"],
    "suite": {
      "shell": ["/dashboard", "/leadedge360", "/retailedge360", "/proposals", "/invoices", "/revenue", "/payments", "/onboarding"],
      "billing": ["/subscribe", "/pricing"]
    },
    "missing": {
      "/dashboard": "Phase 5 — Executive Command Center",
      "/payments": "Phase 8 — Billing Center",
      "/book-demo": "Phase 4 — alias or redirect to /contact"
    }
  },
  "api": {
    "authority": "docs/openapi.json",
    "baseUrl": "https://app.asoftechinsightz.com/api",
    "clientPattern": "src/api/client.js",
    "rules": [
      "Real APIs only — no mock data",
      "Do not change API contracts",
      "Retail inventory: GET/POST /api/products with Bearer JWT",
      "Mobile product list: GET /api/products with Bearer JWT (conflict — always send JWT)",
      "Subscribe checkout: POST /api/billing/checkout + /api/billing/verify",
      "Dedicated payments: /api/payments/* exists but subscribe page uses /api/billing/*"
    ]
  },
  "frozen": {
    "description": "Paths and systems that MUST NOT be modified during V2",
    "paths": ["lib/", "models/", "app/api/", "n8n/", "scripts/migrate-*"],
    "systems": ["MongoDB collections", "database schema", "authentication flows", "Razorpay integration", "lead scoring", "billing logic", "multi-tenant implementation"]
  },
  "components": {
    "primitives": "components/ui/",
    "designSystem": "components/design-system/",
    "suite": "components/suite/",
    "marketing": "components/site/",
    "products": {
      "leadedge360": "components/leadedge360/",
      "retailedge360": "components/retailedge360/",
      "billing": "components/billing/"
    }
  },
  "phases": {
    "current": 2,
    "next": 3,
    "gate": "Approval required before each phase. Commit + screenshots after each phase."
  }
}
