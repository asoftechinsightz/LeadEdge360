# AsoftechInsightz Environment template — copy to `.env` and fill in.
MONGO_URL=mongodb://mongo:27017
DB_NAME=asoftech_saas

NEXT_PUBLIC_BASE_URL=https://app.asoftechinsightz.com
NEXT_PUBLIC_APP_URL=https://app.asoftechinsightz.com
# Production: set to your app URL (not *). Dev may use *.
CORS_ORIGINS=https://app.asoftechinsightz.com

# Mobile JWT (required in production — min 16 chars)
JWT_SECRET=

# Emergent LLM (AI scoring + RevenueShield AI)
EMERGENT_LLM_KEY=

# Emergent Auth (one-click Google sign-in)
EMERGENT_PROJECT_ID=
EMERGENT_API_KEY=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set true in local/staging only — blocked when NODE_ENV=production
BILLING_TEST_MODE=false

# E-004 plan limit enforcement (default false — no blocking until enabled)
ENFORCE_PLAN_LIMITS=false
# Comma-separated org ids exempt from limits when enforcement is on (e.g. Tenant #1)
GRANDFATHER_ORG_IDS=

# E-002 cookie ↔ JWT bridge (default false — mobile JWT-only paths stay 404 for cookie)
WEB_JWT_BRIDGE=false

# E-003 server AEO profile persistence (default false — sessionStorage only)
AEO_SERVER_PROFILE=false

# n8n inbound webhook signing (required in production — change from example)
N8N_WEBHOOK_TOKEN=
# Target org for lead ingest (required in production; per-channel overrides optional)
N8N_WEBHOOK_ORG_ID=
# N8N_WEBHOOK_ORG_WHATSAPP=
# N8N_WEBHOOK_ORG_FACEBOOK=
# N8N_WEBHOOK_ORG_GOOGLE=

# Production: do not allow unauthenticated demo CRM (set true only for CI/staging smoke tests)
ALLOW_PUBLIC_DEMO_ORG=false

# n8n UI (docker-compose — required)
N8N_BASIC_AUTH_PASSWORD=
N8N_BASIC_AUTH_USER=admin
N8N_WEBHOOK_URL=https://flows.asoftechinsightz.com/
