# AsoftechInsightz Environment template — copy to `.env` and fill in.

# --- Optional: override Mongo hostname for scripts (auto: mongo in Docker, 127.0.0.1 on host) ---
# MONGO_HOST_OVERRIDE=127.0.0.1

# --- MongoDB Atlas (recommended; no local install) ---
# 1. https://cloud.mongodb.com → Create free M0 cluster
# 2. Database Access → database user (save username + password)
# 3. Network Access → Add IP → 0.0.0.0/0 (dev) or your server IP (prod)
# 4. Connect → Drivers → copy mongodb+srv://... string
# 5. npm run db:check && npm run db:bootstrap
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=asoftech

# --- VPS MongoDB (local dev → remote server) ---
# Option A — SSH tunnel (recommended; do not expose 27017 on the public internet):
#   ssh -L 27017:127.0.0.1:27017 asoftech@YOUR_VPS_IP
#   MONGO_URL=mongodb://asofadmin:PASSWORD@127.0.0.1:27017/?authSource=admin
#   DB_NAME=asoftech_saas
#
# Option B — direct to VPS IP (open firewall port 27017 for YOUR IP only):
#   MONGO_URL=mongodb://asofadmin:PASSWORD@YOUR_VPS_IP:27017/?authSource=admin
#   DB_NAME=asoftech_saas
#
# On VPS: docker compose up -d mongo
# Test:   npm run db:check && npm run db:bootstrap

# --- Docker (local asoftech-mongo) ---
# MONGO_URL=mongodb://asofadmin:PASSWORD@127.0.0.1:27017/?authSource=admin
# DB_NAME=asoftech_saas

# --- Public URLs (production) ---
# Marketing site:     https://asoftechinsightz.com
# Business Suite:     https://app.asoftechinsightz.com
# Suite API:          https://api.asoftechinsightz.com
# Observability UI:   https://app.observability360.asoftechinsightz.com
# Observability API:  https://api-observability360.asoftechinsightz.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_OBSERVABILITY_APP_URL=https://app.observability360.asoftechinsightz.com
# NEXT_PUBLIC_OBSERVABILITY_API_URL=https://api-observability360.asoftechinsightz.com
CORS_ORIGINS=*

# Public growth-audit form → leads land in this org (defaults to demo-org)
# GROWTH_AUDIT_ORG_ID=demo-org

# Production auth gate (set true in staging/prod)
# REQUIRE_AUTH=true

# Dev login bypass — non-production only (admin@asoftechinsightz.com / ChangeMe@2025)
DEV_AUTH_BYPASS=true

# Runtime certification on production VPS (npm run cert:runtime)
# CERT_ADMIN_EMAIL=admin@asoftechinsightz.com
# CERT_ADMIN_PASSWORD=

# Pilot org provisioning (npm run pilot:provision) — first production customer
# PILOT_ORG_NAME=Acme Pvt Ltd
# PILOT_ORG_ID=acme-pilot
# PILOT_ADMIN_EMAIL=admin@acme.com
# PILOT_ADMIN_PASSWORD=
# PILOT_ADMIN_NAME=Jane Admin
# PILOT_ADMIN_PHONE=+919876543210
# PILOT_INDUSTRY=it_services
# PILOT_GSTIN=
# PILOT_PROPOSAL_PREFIX=ACME
# PILOT_INVOICE_PREFIX=ACME-INV
# PILOT_SEED_SAMPLE=1

# JWT (override in production — never use default secret)
JWT_SECRET=dev-secret-change-me

# Geo Lead Finder — Google Maps / Places (required for /leadedge360/geo-finder)
# 1. https://console.cloud.google.com → APIs & Services → Enable:
#    - Geocoding API
#    - Places API (legacy: places/nearbysearch + textsearch + details)
# 2. Credentials → Create API key → restrict by IP (VPS) + API
# 3. Same key can be used for both vars if both APIs are enabled:
# GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY=
# Or single key:
# GOOGLE_API_KEY=

# Meta Graph (optional — Geo Lead Finder Meta source)
# See docs/platform/META_GEO_LEADS_SETUP.md
# META_ACCESS_TOKEN=

# n8n social autopilot (Week 2 — see docs/marketing/WEEK2_VPS_RUNBOOK.md)
# N8N_ENABLED=true
# N8N_WEBHOOK_URL=http://n8n:5678/webhook/marketing-social-publish
# N8N_WEBHOOK_SECRET=
# AGENT_CRON_SECRET=


# Emergent Auth (one-click Google sign-in)
EMERGENT_PROJECT_ID=
EMERGENT_API_KEY=

# Razorpay (optional during pilot — set before live payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional Razorpay Subscription Plan IDs (map checkout tiers — see lib/billing/subscription-plans.js)
# RAZORPAY_PLAN_RETAIL_STARTER=
# RAZORPAY_PLAN_RETAIL_PROFESSIONAL=
# RAZORPAY_PLAN_LEAD_STARTER=
# RAZORPAY_PLAN_LEAD_GROWTH=
# RAZORPAY_PLAN_BUNDLE_GROWTH_SUITE=

# Microsoft login (optional — same app registration as Microsoft 365 integration)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Optional Redis cache (not required — app runs without it)
# Enable: docker compose --profile with-redis up -d redis
# REDIS_URL=redis://redis:6379

# Optional monitoring stack (Prometheus + Grafana)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
# PROMETHEUS_URL=http://127.0.0.1:9090/-/healthy
# GRAFANA_HOST_PORT=3030
# GRAFANA_URL=http://127.0.0.1:3030/api/health
# PAT_MONITORING_REQUIRED=0

# Backups (PAT production requires a fresh *.archive.gz within 48h)
# BACKUP_ROOT=/opt/asoftech/backups
# PAT_BACKUP_MAX_AGE_HOURS=48

# n8n inbound webhook signing — optional; change from default in production
N8N_WEBHOOK_TOKEN=change-me-to-a-long-random-string

# SMTP (campaign email) — optional; unset = campaigns work without outbound email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# SMS OTP (MSG91) — optional for India deployments
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=ASOFTI

# Public self-service signup (/signup). In production/uat, defaults to enabled only when
# MSG91 or SMTP is configured. Set false to require pilot:provision for new tenants.
# PUBLIC_SIGNUP_ENABLED=false

# Enterprise LeadEdge360 modules — mock API in dev/demo only
# Set false for UAT/production (also auto-disabled when NEXT_PUBLIC_APP_ENV=uat|production)
NEXT_PUBLIC_USE_MOCK_API=true
NEXT_PUBLIC_APP_ENV=development

# Staging / UAT (.env on VPS port 3007):
# NEXT_PUBLIC_APP_ENV=uat
# NEXT_PUBLIC_USE_MOCK_API=false
# NEXT_PUBLIC_APP_URL=http://187.127.179.138:3007
# REQUIRE_AUTH=true
# DEV_AUTH_BYPASS=false
# GROWTH_AUDIT_ORG_ID=demo-org
